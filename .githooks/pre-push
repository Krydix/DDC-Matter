#!/usr/bin/env bash

set -euo pipefail

if [[ "${SKIP_CI_PAGES:-0}" == "1" ]]; then
    echo "pre-push: skipping Pages validation because SKIP_CI_PAGES=1"
    exit 0
fi

ROOT_DIR="$(git rev-parse --show-toplevel)"
ZERO_OID="0000000000000000000000000000000000000000"
SOURCE_OID=""

while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ "$local_oid" == "$ZERO_OID" ]]; then
        continue
    fi

    SOURCE_OID="$local_oid"
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        break
    fi
done

if [[ -z "$SOURCE_OID" ]]; then
    echo "pre-push: no branch update to validate"
    exit 0
fi

SHORT_OID="$(git rev-parse --short "$SOURCE_OID")"
VALIDATION_DIR="$ROOT_DIR/.ci-pages/validated"
VALIDATION_MARKER="$VALIDATION_DIR/$SOURCE_OID"

if [[ -f "$VALIDATION_MARKER" ]]; then
    echo "pre-push: Pages validation already passed for $SHORT_OID"
    exit 0
fi

echo "pre-push: validating outgoing commit $SHORT_OID with the local Pages pipeline"
CI_PAGES_SOURCE_REF="$SOURCE_OID" make -C "$ROOT_DIR" ci-pages

mkdir -p "$VALIDATION_DIR"
touch "$VALIDATION_MARKER"
echo "pre-push: Pages validation passed for $SHORT_OID"
